{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AppLogging": {
    "FlushTimeoutInSeconds": 2,
    "BufferSize": 100,
    "EnableLogBuffering": true
  },
  "AppName": "GnuHiveWebApi",
  // TODO Move to shared config
  "Environment": "Production",
  "Swagger": {
    "ContextRoot": "gnu-hive/"
  },
  "AllowedHosts": "*"
}
